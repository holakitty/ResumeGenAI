# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OPENROUTER_API_KEY: Optional fallback provider for OpenRouter models.
OPENROUTER_API_KEY="MY_OPENROUTER_API_KEY"

# GROQ_API_KEY: Optional fast inference fallback provider via Groq.
GROQ_API_KEY="MY_GROQ_API_KEY"

# OPENAI_API_KEY: Optional precision parser provider via OpenAI (GPT-4o / GPT-4o-mini).
OPENAI_API_KEY="MY_OPENAI_API_KEY"

# RAZORPAY_KEY_ID: Live or test Razorpay Key ID for ₹199 PDF resume exports.
# Can also be dynamically configured via backend API (/api/razorpay/configure-key).
RAZORPAY_KEY_ID="rzp_live_MY_RAZORPAY_KEY_ID"

# RAZORPAY_KEY_SECRET: Secure Razorpay Key Secret stored strictly on backend server.
RAZORPAY_KEY_SECRET="MY_RAZORPAY_KEY_SECRET"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
